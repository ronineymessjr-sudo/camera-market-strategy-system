TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_GOODS_SEARCH_METHOD=taobao.tbk.dg.material.optional

PDD_API_URL=https://gw-api.pinduoduo.com/api/router
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
PDD_GOODS_SEARCH_METHOD=pdd.ddk.goods.search

EBAY_API_URL=https://api.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
