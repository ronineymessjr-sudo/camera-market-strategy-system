# Cloud production example. For local-only development, use sqlite:///./camera_market.db explicitly.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR_DB_PASSWORD]@db.woywgfoqurumrkyoznnb.supabase.co:5432/postgres?sslmode=require
PUBLIC_BASE_URL=https://example.com
FRONTEND_ORIGINS=https://example.com
OPERATOR_API_TOKEN=replace-with-a-long-random-token
# Local scripts set this only for loopback SQLite development. Keep false in cloud runtimes.
LOCAL_DEV_AUTH_BYPASS=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-aud-tag
OPERATOR_EMAIL=owner@example.com
SUPABASE_PROJECT_REF=woywgfoqurumrkyoznnb
SUPABASE_URL=https://woywgfoqurumrkyoznnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_STORAGE_BUCKET=price-evidence
EVIDENCE_MAX_UPLOAD_BYTES=10485760
CRAWLER_CONCURRENCY=3
CRAWLER_TIMEOUT_MS=45000
CRAWLER_MIN_INTERVAL_MINUTES=30
CRAWLER_RETRIES=1
CRAWLER_HEADLESS=true
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60
JOB_POLL_INTERVAL_SECONDS=2

