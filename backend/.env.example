DATABASE_URL=sqlite:///./camera_market.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CRAWLER_CONCURRENCY=3
CRAWLER_TIMEOUT_MS=45000
CRAWLER_MIN_INTERVAL_MINUTES=30
CRAWLER_RETRIES=1
CRAWLER_HEADLESS=true
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60

# Official marketplace APIs. Leave blank to keep that provider disabled.
JD_API_URL=https://api.jd.com/routerjson
JD_APP_KEY=
JD_APP_SECRET=
JD_UNION_ID=
JD_GOODS_QUERY_METHOD=jd.union.open.goods.query

