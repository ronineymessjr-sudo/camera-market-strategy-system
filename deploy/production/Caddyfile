:80 {
  encode zstd gzip
  header X-Robots-Tag "noindex, nofollow"
  header X-Content-Type-Options "nosniff"
  header Referrer-Policy "strict-origin-when-cross-origin"

  @health path /healthz
  respond @health 200

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /static/* {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:3000
  }
}
